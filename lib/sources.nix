# Source files for buildroot builds, as fixed-output derivations.
#
# channels/<name>/sources.json lists what every buildroot directory downloads (generated by the
# tree's own `make -n download`, see scripts/sources.py). Hashes are the buildroot's own
# PKG_HASH / PKG_MIRROR_HASH, so they never need to be maintained separately.
#
# A build gets only the sources it can need: the closure of the requested packages over
# dependencies, build dependencies and package defaults, computed from the channel metadata at
# evaluation time. The closure over-approximates what Kconfig selects (conditions are taken as
# true), so a few unused files may be fetched, never too few.
{
  lib,
  pkgs,
  mkGoModules,
}:
{
  # channel source (for tools/tar/patches) and tree (for package patches)
  src,
  tree,
  metadata,
  sources,
  # channels/<name>/vendor.json: { <dir> = { file; sha256; hash; }; }
  vendor,
}:
let
  storeName = file: "dl-" + lib.strings.sanitizeDerivationName file;
  mirrorUrls = file: map (base: "${base}/${file}") sources.mirrors;

  # Git checkouts are packed into tarballs whose bytes must match PKG_MIRROR_HASH, which needs
  # the buildroot's patched tar (tools/tar/patches change the headers of long names).
  tar = pkgs.gnutar.overrideAttrs (old: {
    postPatch = (old.postPatch or "") + ''
      for p in ${src}/tools/tar/patches/*.patch; do patch -p1 < "$p"; done
    '';
    doCheck = false;
  });

  # include/download.mk DownloadMethod/rawgit, preceded by its source-mirror lookup
  fetchGitSource =
    entry:
    let
      inherit (entry) git;
      ext = lib.last (lib.splitString "." entry.file);
      pack =
        {
          zst = "zstd -T0 --ultra -20 -c";
          xz = "xz -zc -7e";
          gz = "gzip -nc";
          bz2 = "bzip2 -c";
        }
        .${ext} or (throw "immortalwrt.nix: cannot pack ${entry.file}");
      submodules = git.submodules != "skip";
    in
    pkgs.stdenvNoCC.mkDerivation {
      name = storeName entry.file;
      nativeBuildInputs = [
        pkgs.git
        tar
        pkgs.zstd
        pkgs.xz
        pkgs.gzip
        pkgs.bzip2
        pkgs.curl
        pkgs.cacert
      ];
      outputHashMode = "flat";
      outputHashAlgo = "sha256";
      outputHash = entry.sha256;
      impureEnvVars = lib.fetchers.proxyImpureEnvVars;
      env = {
        GIT_SSL_CAINFO = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
        SSL_CERT_FILE = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
      };
      buildCommand = ''
        export HOME=$TMPDIR
        cd $TMPDIR
        for url in ${lib.escapeShellArgs (mirrorUrls entry.file)}; do
          if curl -fsSL --retry 2 -o mirror.dl "$url" \
            && [ "$(sha256sum mirror.dl | cut -d' ' -f1)" = ${entry.sha256} ]; then
            mv mirror.dl $out
            exit 0
          fi
        done
        subdir=${lib.escapeShellArg git.subdir}
        git clone --filter=blob:none ${lib.escapeShellArg git.url} "$subdir"
        (cd "$subdir" && git checkout ${git.rev})
        export TAR_TIMESTAMP=$(cd "$subdir" && git log -1 --no-show-signature --format='@%ct')
        (cd "$subdir" && git config core.abbrev 8 && git archive --format=tar HEAD --output="../$subdir.tar.git")
        ${lib.optionalString submodules ''
          tar --numeric-owner --owner=0 --group=0 --ignore-failed-read -C "$subdir" -f "$subdir.tar.git" -r .git .gitmodules 2>/dev/null || true
        ''}
        rm -rf "$subdir" && mkdir "$subdir"
        tar -C "$subdir" -xf "$subdir.tar.git"
        ${lib.optionalString submodules ''
          (cd "$subdir" && git submodule update --init --recursive -- ${lib.escapeShellArgs git.submodules} && rm -rf .git .gitmodules)
        ''}
        tar --numeric-owner --owner=0 --group=0 --mode=a-s --sort=name \
          ''${TAR_TIMESTAMP:+--mtime="$TAR_TIMESTAMP"} -c "$subdir" | ${pack} > $out
      '';
    };

  # scripts/download.pl: try each URL, then the source mirrors, until one has the declared hash.
  # Checking per URL matters: snapshot URLs such as cgit's regenerate their tarballs, so a URL can
  # answer with different bytes, and only the mirrors carry the file the hash was taken from.
  fetchUrlSource =
    entry:
    pkgs.stdenvNoCC.mkDerivation {
      name = storeName entry.file;
      nativeBuildInputs = [ pkgs.curl ];
      outputHashMode = "flat";
      outputHashAlgo = "sha256";
      outputHash = entry.sha256;
      impureEnvVars = lib.fetchers.proxyImpureEnvVars;
      env.SSL_CERT_FILE = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
      buildCommand = ''
        for url in ${lib.escapeShellArgs (entry.urls ++ mirrorUrls entry.file)}; do
          if curl -fsSL --retry 2 --connect-timeout 30 -o "$TMPDIR/dl" "$url"; then
            [ "$(sha256sum "$TMPDIR/dl" | cut -d' ' -f1)" = ${entry.sha256} ] && exec mv "$TMPDIR/dl" $out
            echo "hash mismatch from $url" >&2
          fi
        done
        echo "no URL serves ${entry.file} with sha256 ${entry.sha256}" >&2
        exit 1
      '';
    };

  fetchSource = entry: if entry ? git then fetchGitSource entry else fetchUrlSource entry;

  dirSources =
    dir: map (entry: lib.nameValuePair entry.file (fetchSource entry)) (sources.dirs.${dir} or [ ]);

  # tools/ and toolchain/, needed by every build
  buildDirs = lib.filter (d: lib.hasPrefix "tools/" d || lib.hasPrefix "toolchain/" d) (
    lib.attrNames sources.dirs
  );

  # package/Makefile builds the package manager for the host (apk, or opkg in older trees)
  # without any package depending on it
  packageManagerDirs = lib.filter (d: sources.dirs ? ${d}) [
    "package/system/apk"
    "package/system/opkg"
  ];

  kernelSource =
    target:
    let
      version = metadata.targets.${target}.linux;
      entry =
        sources.kernel.${version}
          or (throw "immortalwrt.nix: kernel ${version} is not in the sources lock");
    in
    lib.nameValuePair entry.file (fetchSource entry);

  # Go modules of a Go package directory (see lib/vendor.nix), from its source file
  goModulesWithHash =
    dir: hash:
    let
      entries = sources.dirs.${dir} or [ ];
    in
    if lib.length entries != 1 then
      throw "immortalwrt.nix: ${dir} has ${toString (lib.length entries)} source files, cannot tell which holds go.mod"
    else
      mkGoModules {
        name = (lib.head entries).file;
        source = fetchSource (lib.head entries);
        patches = "${tree}/${dir}/patches";
        inherit hash;
      };

  # vendored modules: vendor.json records the hash for the source file it was computed from
  goModules =
    dir:
    if (lib.head sources.dirs.${dir}).sha256 == vendor.${dir}.sha256 then
      goModulesWithHash dir vendor.${dir}.hash
    else
      throw "immortalwrt.nix: vendor.json describes another source of ${dir}; run the refresh";

  # virtual package names (PROVIDES) to the packages providing them
  providers = lib.zipAttrs (
    lib.concatLists (
      lib.mapAttrsToList (name: p: map (v: { ${v} = name; }) (p.provides or [ ])) metadata.packages
    )
  );
  resolveName = name: if metadata.packages ? ${name} then [ name ] else providers.${name} or [ ];

  # packages defaulting on when PACKAGE_<name> is selected: { <name> = [ package ]; }
  triggeredBy = lib.zipAttrs (
    lib.concatLists (
      lib.mapAttrsToList (
        name: p:
        map (s: { ${lib.removePrefix "PACKAGE_" s} = name; }) (
          lib.filter (lib.hasPrefix "PACKAGE_") (if lib.isList (p.default or null) then p.default else [ ])
        )
      ) metadata.packages
    )
  );

  # Kconfig symbols that are set for a build of `profiles` on `target`
  targetSymbols =
    target: profiles:
    let
      parts = lib.splitString "/" target;
      board = lib.head parts;
      sub = "${board}_${lib.last parts}";
    in
    [
      "BUILDBOT"
      "TARGET_${board}"
      "TARGET_${sub}"
    ]
    ++ lib.concatMap (p: [
      "TARGET_${sub}_DEVICE_${p}"
      "TARGET_DEVICE_${sub}_DEVICE_${p}"
    ]) profiles;

  closure =
    {
      target,
      profiles,
      packages,
    }:
    let
      targetInfo = metadata.targets.${target};
      symbols = lib.genAttrs (targetSymbols target profiles) (_: true);
      defaulted = lib.attrNames (
        lib.filterAttrs (
          _: p: p ? default && (p.default == true || lib.any (s: symbols ? ${s}) p.default)
        ) metadata.packages
      );
      # packages Kconfig options outside dependencies select (scripts/metadata.py config_selects)
      configSelected = lib.concatMap (
        s:
        lib.optionals (
          (!(s ? arches) || lib.elem targetInfo.arch s.arches)
          && (!(s ? targets) || lib.any (t: symbols ? ${t}) s.targets)
        ) s.packages
      ) metadata.configSelects;
      wanted = lib.filter (p: !lib.hasPrefix "-" p) (
        packages
        ++ targetInfo.defaultPackages
        ++ lib.concatMap (p: targetInfo.profiles.${p}) profiles
        ++ configSelected
      );
      pkgClosure = builtins.genericClosure {
        startSet = map (key: { inherit key; }) (lib.concatMap resolveName wanted ++ defaulted);
        operator =
          { key }:
          map (key: { inherit key; }) (
            lib.concatMap resolveName (metadata.packages.${key}.depends or [ ]) ++ triggeredBy.${key} or [ ]
          );
      };
      dirClosure = builtins.genericClosure {
        startSet = map (key: { inherit key; }) (
          packageManagerDirs ++ map (p: metadata.packages.${p.key}.source) pkgClosure
        );
        operator = { key }: map (key: { inherit key; }) (metadata.sources.${key}.buildDepends or [ ]);
      };
    in
    {
      packages = map (p: p.key) pkgClosure;
      dirs = map (d: d.key) dirClosure;
    };

  mkDl =
    name: target: dirs:
    pkgs.linkFarm "${name}-dl" (
      lib.listToAttrs ([ (kernelSource target) ] ++ lib.concatMap dirSources (buildDirs ++ dirs))
    );
in
{
  inherit resolveName goModules goModulesWithHash;

  # dl/ for the toolchain stage: tools/, toolchain/ and the target's kernel
  toolchain = name: target: mkDl name target [ ];

  # dl/ and Go modules for building `packages` and `profiles` on `target`, plus the Go packages
  # in the closure whose modules are not vendored (the build fails if Kconfig selects one)
  packages =
    name:
    {
      target,
      profiles,
      packages,
    }@args:
    let
      c = closure args;
      goDirs = lib.filter (d: metadata.sources.${d}.go or false) c.dirs;
    in
    {
      dl = mkDl name target c.dirs;
      goModules = map goModules (lib.filter (d: vendor ? ${d}) goDirs);
      unvendoredGo = lib.filter (
        p: lib.elem metadata.packages.${p}.source goDirs && !(vendor ? ${metadata.packages.${p}.source})
      ) c.packages;
    };
}
